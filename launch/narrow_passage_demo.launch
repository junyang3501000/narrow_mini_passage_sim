<?xml version="1.0"?>
<launch>
  <!-- 是否打开 gzclient 图形窗口；false 时仍运行无界面的 gzserver。 -->
  <arg name="gui" default="true"/>
  <!-- 本次任务纵向投影进度目标，透传给主仿真 launch。 -->
  <arg name="passage_distance" default="9.0"/>

  <!--
    演示文件不重复定义任何节点，而是复用主启动文件，并唯一地把 auto_enable 改为 true。
    因此它与 narrow_passage_sim.launch 的区别只是：传感器就绪后车辆会自动开始运动。
  -->
  <include file="$(find ranger_mini_narrow_sim)/launch/narrow_passage_sim.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="auto_enable" value="true"/>
    <arg name="passage_distance" value="$(arg passage_distance)"/>
  </include>
</launch>
